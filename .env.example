# 本地完整模型目录，相对路径以 V6 仓库根目录为准。此文件不包含模型权重。
T2Q_EMBEDDING_MODEL=../models/Qwen3-Embedding-8B
T2Q_RERANKER_MODEL=../models/Qwen3-Reranker-8B

# 两路召回深度及 RRF 平滑常数。
T2Q_RECALL_BM25_TOP_K=50
T2Q_RECALL_EMBEDDING_TOP_K=50
T2Q_RECALL_RRF_K=60

# 默认开启本地重排；缺少权重时明确报错，不自动下载或跳过。
T2Q_RECALL_RERANK_ENABLED=true
T2Q_RECALL_RERANK_TOP_K=50
T2Q_RERANKER_DEVICE=cpu
T2Q_RERANKER_DTYPE=auto
T2Q_RERANKER_BATCH_SIZE=8
T2Q_RERANKER_MAX_LENGTH=2048

# 真实模型集成测试默认关闭；后续需在进程环境中显式传入此开关，.env 不自动启用测试。
T2Q_RUN_MODEL_TESTS=0
